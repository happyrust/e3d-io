-- e3d-io write-path gate, read back by E3D itself in a TTY session (read-only: no
-- SAVEWORK, no QUIT — the l3_suite driver's wrapper owns the session). Rendered by
-- tools/e3d/write_gate.ps1 from this template: {{LOGDIR}} and the refnos come from the
-- e3d-write-box run on the project copy.
--
-- Sessions e3d-write-box --group --hunk appended:
--   BOX {{BOX}} under the first ZONE {{ZONE}}
--   GPWL {{GPWL}} under the WORL, GROU {{GROU}} with reference members ZONE + BOX
--   EQUI {{EQUI1}} and EQUI {{EQUI2}}: DESC / DESP / UUIDIA as hunks (types 22/21/20),
--     one chain across a page boundary
--   FIXING {{FIXING}}: ROKEYS inline type 19, ROVALS as a type-23 hunk
--
-- One ALPHA LOG block per question: a block's log is written only at ALPHA LOG END, so an
-- unhandled error loses that block's log and no other. Every navigation and every risky Q
-- is followed by handle any.

ALPHA LOG "{{LOGDIR}}/00_project.log" OVER
$P GATE-00-BEGIN
Q PROJ
Q MDB
$P GATE-00-END
ALPHA LOG END

ALPHA LOG "{{LOGDIR}}/10_box.log" OVER
$P GATE-10-BEGIN
={{BOX}}
handle any
  $P GATE-10-NAV-ERROR $!!error.text
elsehandle none
  Q REF
  Q TYPE
  Q OWNER
  Q POS
  Q XLEN
  Q YLEN
  Q ZLEN
endhandle
$P GATE-10-END
ALPHA LOG END

ALPHA LOG "{{LOGDIR}}/20_grou.log" OVER
$P GATE-20-BEGIN
={{GROU}}
handle any
  $P GATE-20-NAV-ERROR $!!error.text
elsehandle none
  Q REF
  Q TYPE
  Q OWNER
  Q MEM
endhandle
={{GPWL}}
handle any
  $P GATE-20-GPWL-NAV-ERROR $!!error.text
elsehandle none
  Q REF
  Q TYPE
  Q OWNER
  Q MEM
endhandle
$P GATE-20-END
ALPHA LOG END

