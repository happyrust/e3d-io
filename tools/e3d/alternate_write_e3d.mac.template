-- e3d-io write-path gate, T4 alternate-write: one E3D-written round (plan §2 T4,
-- "E3D 写 → e3d-io 写 → E3D 写 → …"). Run by tools/e3d/alternate_write_gate.ps1 as the
-- E3D half of round {{ROUND}}: E3D opens the project (its newest session is e3d-io's from
-- the round before), creates an EQUI under the first ZONE and SAVEWORKs, so the file now
-- has an E3D session on top of an e3d-io one. Rendered: {{LOGDIR}}, {{MACROLOG}},
-- {{ZONE}} (=refno of the first ZONE), {{E3DNAME}} (the EQUI's name), {{ROUND}}, {{POS}}.
--
-- Read-back of e3d-io's previous round is the readback macro's job (Q MEM lists every
-- name); here the point is only that E3D can SAVEWORK on top of an e3d-io base.

ALPHA LOG "{{LOGDIR}}/alt_e3d_{{ROUND}}.log" OVER
$P ALT-E3D-{{ROUND}}-BEGIN
={{ZONE}}
handle any
  $P ALT-E3D-NAV-ERROR $!!error.text
elsehandle none
  NEW EQUI /{{E3DNAME}}
  handle any
    $P ALT-E3D-NEW-ERROR $!!error.text
  elsehandle none
    POS E {{POS}} N 0 U 0
    $P ALT-E3D-EQUI
    Q REF
    Q OWNER
    SAVEWORK
    handle any
      $P ALT-E3D-SAVE-ERROR $!!error.text
    elsehandle none
      $P ALT-E3D-SAVED
      Q SESSION
    endhandle
  endhandle
endhandle
$P ALT-E3D-{{ROUND}}-END
ALPHA LOG END

-- The driver reads <macro>.log as the scenario log: a summary marker.
ALPHA LOG "{{MACROLOG}}" OVER
$P E3DIO-GATE-DONE alt E3D round {{ROUND}}, see {{LOGDIR}}/alt_e3d_{{ROUND}}.log
ALPHA LOG END
