# 行尾约定：仓库里一律 LF，检出也是 LF（不分平台）。
# 背景：2026-09-20 之前索引全是 LF、工作树却有 98 个文件是 CRLF / 混杂，全靠 stat 缓存才不显示为 modified，
# 谁 touch 一下（各会话常用 LastWriteTime=Get-Date 逼 cargo 重编）它就冒出来变成假改动。
* text=auto eol=lf

# E3D schema 二进制字典：不做任何行尾 / 差异处理。
*.dat binary

# Q13 evidence manifest hashes the original driver/CLI bytes, including BOM/CRLF.
docs/evidence/assets/2026-10-04-q13-gate/** -text whitespace=cr-at-eol

# Allocation probe evidence retains the original IB/TTY output bytes.
docs/evidence/assets/2026-10-05-allocation/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/evidence/assets/2026-10-05-allocation-q14/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Scale profiling and regression manifests cover original native output bytes.
docs/evidence/assets/2026-10-05-staging-scale/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# S6b page-1 bucket probe retains native logs and manifests byte-for-byte.
docs/evidence/assets/2026-10-05-s6b/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
