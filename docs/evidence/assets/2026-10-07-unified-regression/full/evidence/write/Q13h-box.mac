-- Independently rendered spatial questions, one fresh TTY snapshot per call.
ALPHA LOG "D:/e3dio-regression/20261007-133329-46342331/write/logs/Q13h-box.log" OVER
$P [Q13h-box-BEGIN]
VAR !q13 EVALUATE (REF) FOR ALL BOX WITHIN VOLUME =24384/24777 100000
handle any
  $P Q13-ERROR $!!error.text
endhandle
$P [Q13h-box-RESULT-BEGIN]
Q VAR !q13
handle any
  $P Q13-ERROR $!!error.text
endhandle
$P [Q13h-box-RESULT-END]
$P [Q13h-box-END]
ALPHA LOG END
ALPHA LOG "D:/e3dio-regression/20261007-133329-46342331/write/Q13h-box.log" OVER
$P E3DIO-GATE-DONE
ALPHA LOG END


